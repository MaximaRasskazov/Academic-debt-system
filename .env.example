# Конфиг для docker compose. Скопируйте в .env (рядом с docker-compose.yml)
# и подставьте свои значения. .env находится в .gitignore.

# Application
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL
DB_NAME=academic_debts
DB_USER=academic
DB_PASSWORD=academic

# JWT и сессии. JWT_SECRET — обязателен (минимум 32 байта).
# Сгенерировать локально: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-please-do-not-use-this
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie для refresh-токена. На проде с HTTPS COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAMESITE=lax

# CORS.
ALLOWED_ORIGINS=http://localhost:5173
