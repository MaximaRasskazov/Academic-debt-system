# Шаблон прод-конфига для docker-compose.yml (деплой на сервере).
#
# На сервере:
#   cp .env.prod.example .env
#   # заполнить РЕАЛЬНЫМИ значениями (секреты, домены, хеш пароля)
#   docker compose pull && docker compose up -d
#
# Реальный .env в .gitignore — секреты не коммитятся. В отличие от
# docker-compose.prod.yml, продовый docker-compose.yml НЕ имеет дефолтов:
# любая незаданная переменная роняет `docker compose up` с ошибкой.

# Application
LOG_LEVEL=info

# PostgreSQL. Внутри docker-сети backend ходит на сервис "postgres:5432"
# (захардкожено в compose), эти значения создают саму БД и юзера.
DB_NAME=academic_debts
DB_USER=academic
DB_PASSWORD=CHANGE-ME-strong-db-password

# JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie для refresh-токена. На HTTPS-проде Secure ОБЯЗАТЕЛЬНО true.
# COOKIE_DOMAIN пустой — кука привяжется к хосту автоматически.
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAMESITE=lax

# CORS. Origin основного домена (тот же, что DOMAIN ниже, со схемой https).
ALLOWED_ORIGINS=https://your-domain.example

# Dev-сиды: на проде ОБЯЗАТЕЛЬНО false — демо-аккаунты не нужны.
SEED_DEV_ACCOUNTS=false

# SMTP. По умолчанию письма уходят в mailpit (UI на mail-поддомене).
# Для реальной доставки задай внешний SMTP_HOST и credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example

# Синхронизация с эмулятором деканата — опционально, можно оставить пустым.
EMULATOR_URL=
EMULATOR_API_KEY=
SYNC_INTERVAL=5m

# --- Caddy / TLS / поддомены ---

# Email для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@your-domain.example

# Основной домен сайта и поддомен Mailpit. A-записи обоих → IP сервера.
DOMAIN=your-domain.example
MAIL_DOMAIN=mail.your-domain.example

# Basic auth для Mailpit-UI. Хеш пароля сгенерировать:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# В .env хеш экранировать НЕ нужно (одинарные кавычки, если есть $).
MAILPIT_USER=admin
MAILPIT_PASS_HASH='CHANGE-ME-bcrypt-hash-from-caddy-hash-password'
