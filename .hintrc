{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": [
      "default",
      {
        "label": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "moz-appearance",
          "user-select",
          "backdrop-filter"
        ]
      }
    ],
    "no-inline-styles": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 144",
    "not chrome <= 144",
    "not edge <= 144",
    "not ios_saf <= 26.2",
    "not opera <= 125",
    "not safari <= 26.2",
    "not samsung <= 29"
  ]
}