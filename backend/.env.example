# Application
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=academic_debts
DB_USER=academic
DB_PASSWORD=academic

# JWT и сессии. JWT_SECRET — обязателен (минимум 32 байта).
# Сгенерировать локально: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-please-do-not-use-this
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie для refresh-токена. На проде с HTTPS COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAMESITE=lax

# CORS. Origin'ы фронта через запятую.
ALLOWED_ORIGINS=http://localhost:5173
